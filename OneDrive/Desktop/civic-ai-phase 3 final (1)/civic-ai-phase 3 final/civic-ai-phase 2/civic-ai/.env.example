# ==============================================================================
# Civic AI - Environment Configuration Example
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="Civic AI Backend"
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://civic_user:civic_password@localhost:5432/civic_ai_db

# Security & Authentication (JWT)
# Use `openssl rand -hex 32` to generate a strong secret in production
JWT_SECRET=civic-ai-super-secret-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service Configuration (Phase 4 / 5 Placeholder)
AI_SERVICE_URL=http://localhost:8001
AI_INFERENCE_TIMEOUT_SECONDS=30

# Map & Geolocation Provider (Phase 6 Placeholder)
MAP_PROVIDER_KEY=your-maps-api-key-placeholder
MAP_DEFAULT_LATITUDE=12.9716
MAP_DEFAULT_LONGITUDE=77.5946

# Push Notifications (Phase 8 Placeholder)
PUSH_NOTIFICATION_CONFIG={"provider": "fcm", "server_key": "your-fcm-server-key"}

# Risk Engine Thresholds (Phase 7 Placeholder)
RISK_THRESHOLDS={"low_max": 25.0, "medium_max": 60.0, "high_max": 85.0}

# Community Verification Radius in meters (Phase 7 Placeholder)
COMMUNITY_RADIUS=500.0

# Gamification Point Values (Phase 9 Placeholder)
POINT_VALUES={"report_created": 10, "verification_submitted": 5, "issue_resolved": 25}
